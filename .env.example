# Скопируйте в .env. Никогда не публикуйте токен и пароль в GitHub.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLLING_ENABLED=true
CHECK_INTERVAL_MIN=15
SCHEDULER_ENABLED=true
OZON_HEADLESS=false
OZON_TIMEOUT_MS=30000
# Часовой пояс времени в сообщениях Telegram
APP_TIMEZONE=Europe/Moscow
# При появлении только JSON-LD нет подтверждения вида банковской скидки.
# Для публичного доступа установите длинный пароль и используйте HTTPS.
# Локально приложение доступно только на 127.0.0.1 без пароля.
APP_PASSWORD=

# Автоматический backup SQLite (раз в сутки), плюс ручной bash backup.command
BACKUP_INTERVAL_HOURS=24
